# =============================================================================
# WhatsBase configuration
# Copy this file to .env and fill in the values marked REQUIRED.
# The local-demo defaults below work as-is with infra/docker-compose.yml.
# =============================================================================

# --- REQUIRED: model providers (the system does not run without these) -------
ANTHROPIC_API_KEY=                     # REQUIRED. Conversation agent (claude-sonnet-4-6).
OPENAI_API_KEY=                        # REQUIRED. Vision captioning + embeddings.

# --- Local infrastructure (defaults match infra/docker-compose.yml) ----------
DATABASE_URL=postgresql+asyncpg://whatsbase:whatsbase@localhost:5432/whatsbase
REDIS_URL=redis://localhost:6379/0

# --- Intake mode -------------------------------------------------------------
# polling = local/demo (no public URL needed). webhook = production.
INTAKE_MODE=polling

# --- App ---------------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
# Encrypts WhatsApp tokens stored in the DB. Fine for local; generate your own
# for any real use, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_ENCRYPTION_KEY=local-dev-only-change-me

# --- Supabase (hosted setup only) --------------------------------------------
# Not needed for the local backend demo, which uses the local Postgres above.
# Required if you run Auth and image Storage through Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Green API: real WhatsApp loop (optional) --------------------------------
# Leave blank to run the local backend demo without a WhatsApp number.
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# Comma-separated whitelist of numbers allowed to message a live demo agent.
ALLOWED_TEST_NUMBERS=

# --- Langfuse tracing (optional) ---------------------------------------------
# Leave blank to disable tracing (no-op).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
