# Copy to backend/.env and fill in. Every variable from SPEC.md is listed here.
# NEVER commit a filled-in .env. Tokens must never be logged.

# --- LLM providers ---
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxx

# --- Supabase / Postgres ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# asyncpg DSN. Use the Supabase connection string with the +asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Queue ---
REDIS_URL=redis://localhost:6379
# arq job timeout for full catalog builds (seconds). Default 14400 = 4 hours.
BUILD_JOB_TIMEOUT_SECONDS=14400

# --- Observability (leave blank to disable Langfuse; tracing degrades to noop) ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Runtime behavior ---
# When true, builder skips the 8-question self-test and goes live on finalize.
BUILD_SKIP_SELF_TEST=true
# polling (local dev + demo) | webhook (production)
INTAKE_MODE=polling
APP_BASE_URL=http://localhost:8000
# Re-engagement automation (stale not_interested leads).
REENGAGEMENT_ENABLED=false
REENGAGEMENT_DRY_RUN=true
REENGAGEMENT_CRON_HOUR_UTC=6
REENGAGEMENT_STALE_DAYS=60
REENGAGEMENT_MAX_DAILY_PER_TENANT=25
REENGAGEMENT_MAX_ATTEMPTS_PER_LEAD=3
REENGAGEMENT_COOLDOWN_DAYS=30
REENGAGEMENT_MIN_CONFIDENCE=0.65

# --- Secrets ---
# Key used to encrypt per-tenant Green API tokens at rest (Fernet/AES). Generate
# a strong random value; rotate out of band.
TOKEN_ENCRYPTION_KEY=
